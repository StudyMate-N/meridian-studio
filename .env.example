# ──────────────────────────────────────────────────────────────────────────────
# Meridian Studio — environment template
# Copy to `.env` and fill in. NEVER commit the real `.env`.
# ──────────────────────────────────────────────────────────────────────────────

# Frontend (Vite) — exposed to the browser bundle.
VITE_SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-public-key"
VITE_WHATSAPP_NUMBER="12057279363"

# ── Google OAuth ───────────────────────────────────────────────────────────────
# Created in Google Cloud Console → APIs & Services → Credentials → OAuth client ID
# (Web application). These are the ONLY two values you must supply by hand.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=""        # ...apps.googleusercontent.com
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=""           # GOCSPX-...

# ── Used only by scripts/enable-google-auth.sh (hosted-project automation) ──────
# Personal access token: https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=""                           # sbp_...
# Project ref = the subdomain of VITE_SUPABASE_URL (e.g. abcdwxyz)
SUPABASE_PROJECT_REF=""
